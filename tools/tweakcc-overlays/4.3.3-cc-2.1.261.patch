+import { describe, expect, it } from 'vitest';
+
+import { writeUserMessageDisplay } from './userMessageDisplay';
+import type { UserMessageDisplayConfig } from '../types';
+
+const config: UserMessageDisplayConfig = {
+  format: ' > {} ',
+  foregroundColor: 'rgb(1,2,3)',
+  backgroundColor: 'default',
+  borderStyle: 'none',
+  borderColor: 'rgb(4,5,6)',
+  paddingX: 0,
+  paddingY: 0,
+  fitBoxToContent: false,
+  styling: ['bold'],
+};
+
+const cc21257 =
+  '//__TWEAKCC_MODULE_BOUNDARY__\n' +
+  'function cR(x5){let Ku=y(19),{addMargin:_5,param:P5}=x5,{text:Oa}=P5;' +
+  'let Vu=TWe(Oa);if(!Oa){return h(Error("No content found in user prompt message")),null}' +
+  'let Yu=!1,uS=void 0,mR;if(Ku[10]!==Vu||Ku[11]!==uS||Ku[12]!==Yu)' +
+  'mR=e(CWe,{text:Vu,useBriefLayout:Yu,timestamp:uS}),Ku[13]=mR;else mR=Ku[13];' +
+  'let bI;bI=e(o,{flexDirection:"column",marginTop:0,children:mR});return bI}' +
+  'function wI(Xu,W5){return e(o,{children:r(n,{children:[e(n,{color:"success",children:"x"})]})},W5)}' +
+  '\n//__TWEAKCC_MODULE_BOUNDARY__';
+
+describe('writeUserMessageDisplay', () => {
+  it('uses module-local JSX, Box, and Text identifiers on CC 2.1.257', () => {
+    const result = writeUserMessageDisplay(cc21257, config)!;
+
+    expect(result).not.toBeNull();
+    expect(result).toContain(
+      'mR=e(o,{children:e(n,{color:"rgb(1,2,3)",bold:!0,children:` > ${Vu} `})})'
+    );
+    expect(result).toContain('bI=e(o,{flexDirection:"column"');
+    expect(result).not.toContain('CHALK_VAR');
+    expect(() => new Function(result)).not.toThrow();
+  });
+});
