+import { describe, expect, it } from 'vitest';
+import { CUSTOM_MODELS, writeModelCustomizations } from './modelSelector';
+
+describe('model selector CC 2.1.261', () => {
+  const fixture = 'function vto(e,t){let r=kto(e,t),o=r??yto(e),d=a.ANTHROPIC_CUSTOM_MODEL_OPTION;' +
+    'if(d&&!o.some((N)=>N.value===d))o.push({value:d,label:d,description:`Custom model (${d})`});' +
+    'o=Cto(o,t);return ZU(o,t)}';
+
+  it('keeps server rows and runs injected rows through downstream filters', () => {
+    const result = writeModelCustomizations(fixture)!;
+    expect(result).not.toBeNull();
+    const existing = { ...CUSTOM_MODELS[0], label: 'Server label' };
+    const filtered: unknown[][] = [];
+    const fn = new Function('kto', 'yto', 'a', 'Cto', 'ZU', result + ';return vto')(
+      () => [existing], () => [], {},
+      (rows: unknown[]) => { filtered.push(rows); return rows; },
+      (rows: unknown[]) => rows
+    );
+    const rows = fn(false, null);
+    expect(rows).toHaveLength(CUSTOM_MODELS.length);
+    expect(rows[0]).toEqual(existing);
+    expect(filtered[0]).toBe(rows);
+  });
+
+  it('handles dollar identifiers and preserves parseability', () => {
+    // Rename identifiers only in a minimal fixture, not string contents.
+    const source = 'function $fn(e,t){let $r=kto(e,t),$o=$r??yto(e),$d=a.ANTHROPIC_CUSTOM_MODEL_OPTION;return $o}';
+    expect(() => new Function(writeModelCustomizations(source)!)).not.toThrow();
+    expect(writeModelCustomizations(source)).toContain('$o.push(');
+  });
+
+  it('refuses ambiguous or missing current anchors', () => {
+    expect(writeModelCustomizations(fixture + fixture)).toBeNull();
+    expect(writeModelCustomizations('function unrelated(){return []}')).toBeNull();
+  });
+
+  it('retains the legacy literal push path', () => {
+    const old = 'function old(e){let t=[];t.push({value:e,label:e,description:"Custom model"});return t}';
+    expect(writeModelCustomizations(old)).toContain('t.push({"value":');
+  });
+});
